generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  PARTICIPANT
  REPORTER
}

enum MeetingStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  ABSENT
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReportStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
}

enum AccountTokenType {
  PASSWORD_RESET
  INVITE
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  hashedPassword String?
  role           Role     @default(PARTICIPANT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  meetings       Meeting[]
  reports        Report[]
  auditLogs      AuditLog[]
  uploadedAttachments Attachment[]
  accountTokens  AccountToken[]
}

// Single-use tokens for password reset and staff-account invitations. Only the
// SHA-256 hash of the token is stored; the raw token travels in the email link.
model AccountToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      AccountTokenType
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Directory of people who can be invited to meetings. A Contact is NOT an
// authentication account (see User) — invitees receive email/SMS reminders and
// do not log in. Keeping the two apart removes the role-mutation footgun.
model Contact {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  createdAt        DateTime @default(now())
  participants     MeetingParticipant[]
  notifications    Notification[]
  ownedActionItems ReportActionItem[]
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String?
  date        DateTime
  startTime   DateTime?
  endTime     DateTime?
  location    String?
  agenda      String?
  timezone    String?
  status      MeetingStatus @default(PLANNED)
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  participants MeetingParticipant[]
  attachments Attachment[]
  report      Report?
  notifications Notification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([organizerId])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  contactId String
  status    ParticipantStatus @default(INVITED)
  role      String?
  createdAt DateTime @default(now())

  @@unique([meetingId, contactId])
  @@index([contactId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  meeting     Meeting? @relation(fields: [meetingId], references: [id])
  meetingId   String?
  contact     Contact  @relation(fields: [contactId], references: [id])
  contactId   String
  channel     NotificationChannel
  scheduledAt DateTime
  sentAt      DateTime?
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime @default(now())

  @@index([status, scheduledAt])
  @@index([meetingId])
  @@index([contactId])
}

model Report {
  id          String   @id @default(cuid())
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  meetingId   String   @unique
  title       String
  summary     String?
  content     String?
  status      ReportStatus @default(DRAFT)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  actionItems ReportActionItem[]
  attachments Attachment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportActionItem {
  id          String   @id @default(cuid())
  report      Report   @relation(fields: [reportId], references: [id])
  reportId    String
  description String
  ownerId     String?
  owner       Contact? @relation(fields: [ownerId], references: [id])
  dueDate     DateTime?
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([reportId])
  @@index([ownerId])
  @@index([done])
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  url          String
  meeting      Meeting? @relation(fields: [meetingId], references: [id])
  meetingId    String?
  report       Report?  @relation(fields: [reportId], references: [id])
  reportId     String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  model     String
  modelId   String
  action    String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  timestamp DateTime @default(now())
  diff      Json?

  @@index([model, modelId])
  @@index([actorId])
  @@index([timestamp])
}
