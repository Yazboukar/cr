# Copy to .env and fill values
DATABASE_URL="postgresql://postgres:password@localhost:5432/meetingflow?schema=public"
NEXTAUTH_URL=http://localhost:3000
# Generate a strong value: `openssl rand -base64 32`. The app refuses to start in
# production if this is missing or left as "change-me".
NEXTAUTH_SECRET=change-me
# Optional: default IANA timezone for meetings when none is provided (else Europe/Paris)
DEFAULT_TIMEZONE=Africa/Lome
# Institutional identity for the official report letterhead (sensible Togo defaults)
ORG_COUNTRY=RÉPUBLIQUE TOGOLAISE
ORG_MOTTO=Travail – Liberté – Patrie
ORG_MINISTRY=Ministère de l'agriculture, de la pêche, des ressources animales et de la souveraineté alimentaire
ORG_DEPARTMENT=Secrétariat Général
ORG_PLACE=Lomé
# Optional official coat of arms: place the PNG at public/emblem.png to embed it
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
ADMIN_EMAIL=admin@example.com
